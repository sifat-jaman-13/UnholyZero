# Local-only Ollama endpoint. Do not set this to a public or remote address.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ornith-1.5:9b

# Required for each run. Keep sources narrowly scoped and trustworthy.
AGENT_TOPIC=
AGENT_SOURCE_URLS=
AGENT_ALLOWED_DOMAINS=

# Autonomous publishing defaults. Every generated post still passes source,
# citation, quality, and safety gates before it is written.
AGENT_DRY_RUN=false
AGENT_CREATE_PR=true
