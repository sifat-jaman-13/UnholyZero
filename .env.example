# Local-only Ollama endpoint. Do not set this to a public or remote address.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ornith-1.5:9b

# Required for each run. Keep sources narrowly scoped and trustworthy.
AGENT_TOPIC=
AGENT_SOURCE_URLS=
AGENT_ALLOWED_DOMAINS=

# Safety defaults: preview only, no git branch, no push, no pull request.
AGENT_DRY_RUN=true
AGENT_CREATE_PR=false
