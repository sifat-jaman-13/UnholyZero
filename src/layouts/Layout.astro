---
const { title = "UnholyZero", description = "Useful developer writing with a slightly unholy sense of humor." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · UnholyZero</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="UnholyZero home">
        <span class="brand-mark">UZ</span>
        <span>UnholyZero</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#latest">Articles</a>
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} UnholyZero</span>
      <span>Made for developers who read error messages.</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    color: #f4f1ea;
    background: #10100f;
    font-synthesis: none;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: #ffb86b; }
  .site-header, .site-footer {
    width: min(1100px, calc(100% - 40px));
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-header { padding: 24px 0; border-bottom: 1px solid #2d2b27; }
  .site-footer { padding: 48px 0; color: #969188; font-size: 0.9rem; }
  nav { display: flex; gap: 24px; color: #b7b1a6; font-size: 0.92rem; }
  .brand { display: inline-flex; gap: 10px; align-items: center; font-weight: 800; letter-spacing: -0.03em; }
  .brand-mark { display: grid; width: 32px; height: 32px; place-items: center; border-radius: 9px; background: #ffb86b; color: #171310; font-size: 0.72rem; }
  main { width: min(1100px, calc(100% - 40px)); margin: auto; }
  .eyebrow { color: #ffb86b; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .button { display: inline-block; border: 1px solid #ffb86b; border-radius: 999px; padding: 11px 17px; color: #ffb86b; font-weight: 700; }
  .button:hover { background: #ffb86b; color: #171310; }
  @media (max-width: 640px) {
    .site-header, .site-footer { width: min(100% - 28px, 1100px); }
    main { width: min(100% - 28px, 1100px); }
    .site-footer { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>
